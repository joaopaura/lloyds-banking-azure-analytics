createOrReplace

	table dim_segment

		column Segment
			dataType: string
			isNameInferred
			summarizeBy: none
			sourceColumn: [Segment]

		partition dim_segment = calculated
			mode: import
			source = DATATABLE ( "Segment", STRING, { { "Personal" }, { "SME" } } )

	table dim_brand

		column Brand
			dataType: string
			isNameInferred
			summarizeBy: none
			sourceColumn: [Brand]

		partition dim_brand = calculated
			mode: import
			source = DATATABLE ( "Brand", STRING, { { "Lloyds Bank" }, { "Halifax" }, { "Bank of Scotland" } } )

	table bridge_steps

		column Step
			dataType: string
			isNameInferred
			summarizeBy: none
			sourceColumn: [Step]
			sortByColumn: Order

		column Order
			dataType: int64
			isNameInferred
			summarizeBy: none
			sourceColumn: [Order]

		partition bridge_steps = calculated
			mode: import
			source = DATATABLE ( "Step", STRING, "Order", INTEGER, { { "Prior year NII", 1 }, { "Volume", 2 }, { "Margin", 3 }, { "Other", 4 } } )

