	column Value
		dataType: string
		isHidden
		lineageTag: 8153b6c1-3f61-463b-a5e7-0ba39c37f756
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = ROW ( "Value", "measures" )

