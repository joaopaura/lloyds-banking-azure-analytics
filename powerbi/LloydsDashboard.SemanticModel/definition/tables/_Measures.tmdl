		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: bbe0c41c-51d8-4e1b-8800-42e5d3ee3829

	/// Loan balance from the credit risk mart (heatmap, stage mix by score / LTV).
	measure 'Risk Balance' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_credit_risk_monthly[Balance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 4e09980d-01ec-44e3-a5ea-ddbe86a5ef12

	measure 'Risk 90+ Balance' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_credit_risk_monthly[Balance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k, fact_credit_risk_monthly[ArrearsBucket] = "90+" )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 225560e0-423b-497e-be89-e5a9f5f85313

	/// 90+ arrears rate for heatmaps (LTV band x credit score).
	measure 'Risk 90+ Rate' = DIVIDE ( [Risk 90+ Balance], [Risk Balance] )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: b460c711-8f96-4bd2-9a8e-6218066ac562

	measure 'Risk ECL' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_credit_risk_monthly[ECL] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
