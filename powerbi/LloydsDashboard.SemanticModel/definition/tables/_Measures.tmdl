		lineageTag: 6876557d-473b-405e-ad1a-6e3248160f39

	measure 'BBL Loans' = CALCULATE ( SUM ( fact_bbl_vintage[Loans] ), fact_bbl_vintage[MonthsOnBook] = 0 )
