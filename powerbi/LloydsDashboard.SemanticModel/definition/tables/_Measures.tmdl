table _Measures
	lineageTag: bca5467e-7949-4685-b526-4fda70872d67

	/// Last month with actual data (31 Aug 2026).
	measure 'Last Actual Date' = CALCULATE ( MAX ( dim_date[Date] ), REMOVEFILTERS ( dim_date ), dim_date[IsActualPeriod] = TRUE () )
		formatString: dd mmm yyyy
		displayFolder: 00 Helpers
		lineageTag: 0f831fb1-f495-4260-be82-59644f53dda1

	/// End of the selected period, capped at the last actual date. Balance KPIs are read at this date.
	measure 'Period End Date' = MIN ( MAX ( dim_date[Date] ), [Last Actual Date] )
		formatString: dd mmm yyyy
		displayFolder: 00 Helpers
		lineageTag: 2c7ad59e-18c8-4ade-baa3-3702d7bbf674

	/// Number of actual months in the selection (used to annualise).
	measure 'Months In Period' =
			VAR _l = [Last Actual Date]
			RETURN
			    COUNTROWS ( FILTER ( VALUES ( dim_date[MonthEnd] ), dim_date[MonthEnd] <= _l ) )
		formatString: #,0
		displayFolder: 00 Helpers
		lineageTag: 4613e431-10b7-4a2a-9d16-4fb90bdd45f8

	measure 'Data As Of' = FORMAT ( [Last Actual Date], "dd mmm yyyy", "en-GB" )
		displayFolder: 00 Helpers
		lineageTag: 44a49d22-9f24-415d-ae0b-eab6187dd23c

	measure 'Selected Period Label' =
			VAR _s = MIN ( dim_date[Date] )
			VAR _e = [Period End Date]
			RETURN
			    FORMAT ( _s, "mmm yyyy", "en-GB" ) & " to " & FORMAT ( _e, "mmm yyyy", "en-GB" )
		displayFolder: 00 Helpers
		lineageTag: 6b35a5cd-0078-404f-a208-0cddaeab92a0

	/// Dynamic title for the Region Deep Dive drill-through page.
	measure 'Selected Region Title' =
			IF (
			    HASONEVALUE ( dim_region[RegionName] ),
			    VALUES ( dim_region[RegionName] ) & " | Regional Director: " & VALUES ( dim_region[RegionalDirector] ),
			    "All UK regions"
			)
		displayFolder: 00 Helpers
		lineageTag: 1f325d6e-905f-4d3f-9e1b-8c6a8b90e0da

	measure 'Interest Income' = SUM ( fact_product_monthly[InterestIncome] )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 1b56bf3e-c489-4932-a77e-8c8999a664a4

	measure 'Interest Expense' = SUM ( fact_product_monthly[InterestExpense] )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: d3aba10c-9c20-4a09-80af-30dba97a6f72

	/// Funds transfer pricing credit earned by deposits.
	measure 'FTP Credit' = SUM ( fact_product_monthly[FTPCredit] )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: d577b6bb-9641-40bb-80af-b95a867ef22d

	/// Funds transfer pricing charge paid by loans.
	measure 'FTP Charge' = SUM ( fact_product_monthly[FTPCharge] )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 18626749-57c5-40db-a968-108212b20618

	/// Net Interest Income on a funds transfer pricing basis (product view).
	measure NII = [Interest Income] - [FTP Charge] + [FTP Credit] - [Interest Expense]
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 5a0ce6bc-2902-4d66-9f40-ac15e1c92efa

	/// Same months of the prior year.
	measure 'NII PY' =
			VAR _start = EDATE ( MIN ( dim_date[Date] ), -12 )
			VAR _end = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			RETURN
			    CALCULATE ( [NII], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[Date], _start, _end ) )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 964c834d-1fbe-4acd-a79a-e4be84494f27

	measure 'NII YoY %' = DIVIDE ( [NII] - [NII PY], [NII PY] )
		formatString: 0.0%
		displayFolder: 01 Income
		lineageTag: 071d6196-9359-4022-8a92-f462be4157c5

	/// Budget for the actual months of the selection.
	measure 'NII Budget' =
			VAR _l = [Last Actual Date]
			RETURN
			    CALCULATE ( SUM ( fact_budget_monthly[BudgetNII] ), KEEPFILTERS ( dim_date[Date] <= _l ) )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 56d330c1-7db7-412b-af99-b106b557c974

	measure 'NII Budget Full Year' = SUM ( fact_budget_monthly[BudgetNII] )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: fa3ecd38-6c91-4322-93b3-34a3becaec9f

	measure 'NII vs Budget' = [NII] - [NII Budget]
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 4d009d00-ca37-42fb-b461-f466a8f2a125

	measure 'NII vs Budget %' = DIVIDE ( [NII] - [NII Budget], [NII Budget] )
		formatString: 0.0%
		displayFolder: 01 Income
		lineageTag: 1526a972-fc98-4d80-bf2e-efc30cfcedd8

	measure 'Fee Income' = SUM ( fact_product_monthly[FeeIncome] )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 0460f340-c72d-420b-a05e-26e27e551ef4

	measure 'Fee Income PY' =
			VAR _start = EDATE ( MIN ( dim_date[Date] ), -12 )
			VAR _end = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			RETURN
			    CALCULATE ( [Fee Income], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[Date], _start, _end ) )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 84e69794-eece-4c41-b0ef-9d3807e9b534

	measure 'Fee Income YoY %' = DIVIDE ( [Fee Income] - [Fee Income PY], [Fee Income PY] )
		formatString: 0.0%
		displayFolder: 01 Income
		lineageTag: b02af5c2-3c27-41c0-863b-2dfda3e2bd62

	measure 'Fee Income Budget' =
			VAR _l = [Last Actual Date]
			RETURN
			    CALCULATE ( SUM ( fact_budget_monthly[BudgetFees] ), KEEPFILTERS ( dim_date[Date] <= _l ) )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: c058d0ce-d99b-4acc-b102-057f11fdc6be

	measure 'Total Income' = [NII] + [Fee Income]
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 11dd6908-0fcf-444c-bfda-1e18e0ca4ea7

	measure 'Total Income PY' = [NII PY] + [Fee Income PY]
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: c47e9473-bbfc-41da-bb9f-db92b5d37e97

	/// Opex by region and cost category (not allocated to products).
	measure 'Operating Costs' = SUM ( fact_opex_monthly[ActualAmount] )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 33318554-e581-44be-8eb7-c11015560dd8

	measure 'Operating Costs PY' =
			VAR _start = EDATE ( MIN ( dim_date[Date] ), -12 )
			VAR _end = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			RETURN
			    CALCULATE ( [Operating Costs], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[Date], _start, _end ) )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: 29c72fca-2039-42a6-ac47-1a454059e935

	measure 'Operating Costs Budget' =
			VAR _l = [Last Actual Date]
			RETURN
			    CALCULATE ( SUM ( fact_opex_monthly[BudgetAmount] ), KEEPFILTERS ( dim_date[Date] <= _l ) )
		formatString: £#,0
		displayFolder: 01 Income
		lineageTag: e99b6913-995e-4617-bf56-f4cb786e8c36

	measure 'Cost Income Ratio' = DIVIDE ( [Operating Costs], [Total Income] )
		formatString: 0.0%
		displayFolder: 01 Income
		lineageTag: 42c87f13-59a6-4f7b-9dc1-1691ce1cc8be

	measure 'Cost Income Ratio PY' = DIVIDE ( [Operating Costs PY], [Total Income PY] )
		formatString: 0.0%
		displayFolder: 01 Income
		lineageTag: d72b32b1-5518-4275-a35c-bc7c9d21b9e6

	/// Change in percentage points.
	measure 'Cost Income Ratio Change pp' = ( [Cost Income Ratio] - [Cost Income Ratio PY] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 01 Income
		lineageTag: c78d4924-7fb3-4ca1-9c51-57021f973581

	/// End of period balance.
	measure 'Customer Deposits' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[EOMBalance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k, dim_product[ProductGroup] = "Deposits" )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: a12f9a76-3a32-4bdd-af46-15b560965c40

	measure 'Customer Deposits PY' =
			VAR _d = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( [Customer Deposits], REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: 07fe2f62-2940-4d0a-8f50-ddfbb51db6cf

	measure 'Customer Deposits YoY %' = DIVIDE ( [Customer Deposits] - [Customer Deposits PY], [Customer Deposits PY] )
		formatString: 0.0%
		displayFolder: 02 Balance Sheet
		lineageTag: f143b832-e7e0-4f33-8f69-37a44f5e240d

	measure 'Current Account Balances' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[EOMBalance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k, dim_product[ProductID] IN { "P01", "P07" } )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: 86b7c12b-cf3b-4ec1-a092-115b0d685d9a

	measure 'Savings Balances' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[EOMBalance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k, dim_product[ProductID] IN { "P02", "P03" } )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: 9cf11443-d62a-4d0b-912b-d6e5910188b1

	measure 'Fixed Term Savings' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[EOMBalance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k, dim_product[ProductID] = "P03" )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: 6a79553d-4ae9-40b1-ae6f-2b8fb5bd01d3

	/// Deposit migration indicator.
	measure 'Fixed Term Share of Deposits' = DIVIDE ( [Fixed Term Savings], [Customer Deposits] )
		formatString: 0.0%
		displayFolder: 02 Balance Sheet
		lineageTag: 2608facb-9d4f-4afe-8677-8a911f25ecf8

	/// Gross customer loans, end of period.
	measure 'Loan Book' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[EOMBalance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k, dim_product[ProductGroup] = "Lending" )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: ab7e9b05-782f-480d-9ae7-5438823b5a41

	measure 'Loan Book PY' =
			VAR _d = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( [Loan Book], REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: f9fdc6be-65c4-41e8-8a93-8f2dc7ce9e42

	measure 'Loan Book YoY %' = DIVIDE ( [Loan Book] - [Loan Book PY], [Loan Book PY] )
		formatString: 0.0%
		displayFolder: 02 Balance Sheet
		lineageTag: da229535-cc93-4bd4-896f-9f5cd0c8621f

	/// Expected credit loss allowance, end of period.
	measure 'ECL Stock' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[ECL] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: 5c952470-199d-443a-a898-4c702213d05c

	measure 'Net Loans' = [Loan Book] - [ECL Stock]
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: 6f88868a-261c-45cc-8f58-6366f25775c7

	measure 'Net Loans PY' =
			VAR _d = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( [Net Loans], REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: d0b62e33-422e-4c0f-aa3d-65b48c263e46

	measure 'Net Loans YoY %' = DIVIDE ( [Net Loans] - [Net Loans PY], [Net Loans PY] )
		formatString: 0.0%
		displayFolder: 02 Balance Sheet
		lineageTag: ced84fd6-2cae-47b6-8339-795ec4cff4f3

	measure 'Loan to Deposit Ratio' = DIVIDE ( [Loan Book], [Customer Deposits] )
		formatString: 0.0%
		displayFolder: 02 Balance Sheet
		lineageTag: 17663821-c8c5-48e7-8ad2-7d2491fe646e

	/// Average of month-end loan balances in the period (NIM denominator).
	measure 'Avg Loan Balance' =
			VAR _l = [Last Actual Date]
			RETURN
			    AVERAGEX (
			        FILTER ( VALUES ( dim_date[MonthEnd] ), dim_date[MonthEnd] <= _l ),
			        CALCULATE ( SUM ( fact_product_monthly[EOMBalance] ), dim_product[ProductGroup] = "Lending" )
			    )
		formatString: £#,0
		displayFolder: 02 Balance Sheet
		lineageTag: d123c269-9d3e-4a53-864e-a43ffb4f0da4

	/// Net interest margin: annualised NII over average customer loans.
	measure NIM = DIVIDE ( [NII] * 12 / [Months In Period], [Avg Loan Balance] )
		formatString: 0.00%
		displayFolder: 02 Balance Sheet
		lineageTag: 4b5d577a-2f47-43f5-ad9b-dafde3a3e17f

	measure 'NIM PY' =
			VAR _start = EDATE ( MIN ( dim_date[Date] ), -12 )
			VAR _end = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			RETURN
			    CALCULATE ( [NIM], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[Date], _start, _end ) )
		formatString: 0.00%
		displayFolder: 02 Balance Sheet
		lineageTag: f7055f57-65bc-416c-bc70-6e88324b807f

	/// Change in basis points.
	measure 'NIM Change bps' = ( [NIM] - [NIM PY] ) * 10000
		formatString: +0;-0;0
		displayFolder: 02 Balance Sheet
		lineageTag: ccff8274-4bac-4b36-bee9-9bff7d0bf10f

	/// Average Bank of England Bank Rate in the period (real data).
	measure 'Bank Rate' = DIVIDE ( AVERAGE ( fact_bank_rate_daily[BankRate] ), 100 )
		formatString: 0.00%
		displayFolder: 02 Balance Sheet
		lineageTag: 5fa1ae0f-80fc-4081-8807-b4f456dee336

	measure 'Bank Rate Period End' =
			VAR _d = [Period End Date]
			RETURN
			    CALCULATE ( DIVIDE ( MAX ( fact_bank_rate_daily[BankRate] ), 100 ), REMOVEFILTERS ( dim_date ), dim_date[Date] = _d )
		formatString: 0.00%
		displayFolder: 02 Balance Sheet
		lineageTag: e2b7abd0-1001-4f0a-ae84-d7871957e553

	/// Balance-weighted average rate paid on deposits.
	measure 'Customer Rate Deposits' =
			CALCULATE (
			    DIVIDE ( SUM ( fact_product_monthly[RateXBalance] ), SUM ( fact_product_monthly[AvgBalance] ) ) / 100,
			    dim_product[ProductGroup] = "Deposits"
			)
		formatString: 0.00%
		displayFolder: 02 Balance Sheet
		lineageTag: 1a60698d-988f-438d-ad3f-24be03434f13

	measure 'Customer Rate Loans' =
			CALCULATE (
			    DIVIDE ( SUM ( fact_product_monthly[RateXBalance] ), SUM ( fact_product_monthly[EOMBalance] ) ) / 100,
			    dim_product[ProductGroup] = "Lending"
			)
		formatString: 0.00%
		displayFolder: 02 Balance Sheet
		lineageTag: 3cbef9f0-0612-4851-88ba-d57a92fc7c90

	/// Share of Bank Rate passed to depositors.
	measure 'Deposit Beta' =
			VAR _cur = [Customer Rate Deposits]
			VAR _br = [Bank Rate]
			RETURN
			    DIVIDE ( _cur, _br )
		formatString: 0.0%
		displayFolder: 02 Balance Sheet
		lineageTag: 93e39e47-6024-4f05-8190-7026894f583a

	/// Sum of monthly average balances (volume driver).
	measure 'Balance Months' = SUM ( fact_product_monthly[AvgBalance] )
		formatString: £#,0
		displayFolder: 03 NII Bridge
		lineageTag: 924cc62d-9f8f-48be-b7a4-c894336cf893

	measure 'Balance Months PY' =
			VAR _start = EDATE ( MIN ( dim_date[Date] ), -12 )
			VAR _end = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			RETURN
			    CALCULATE ( [Balance Months], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[Date], _start, _end ) )
		formatString: £#,0
		displayFolder: 03 NII Bridge
		lineageTag: 9b090360-50f8-49c8-b2ec-b682d301cda1

	/// NII change explained by balance growth at prior-year margin, per product.
	measure 'Bridge Volume Effect' =
			SUMX (
			    VALUES ( dim_product[ProductID] ),
			    VAR _mpy = DIVIDE ( [NII PY], [Balance Months PY] )
			    RETURN ( [Balance Months] - [Balance Months PY] ) * _mpy
			)
		formatString: £#,0
		displayFolder: 03 NII Bridge
		lineageTag: 4273f75d-615a-4e3c-ad3e-a537efd92d40

	/// NII change explained by margin change (rates, deposit beta, repricing), per product.
	measure 'Bridge Margin Effect' =
			SUMX (
			    VALUES ( dim_product[ProductID] ),
			    VAR _mcy = DIVIDE ( [NII], [Balance Months] )
			    VAR _mpy = DIVIDE ( [NII PY], [Balance Months PY] )
			    RETURN ( _mcy - _mpy ) * [Balance Months]
			)
		formatString: £#,0
		displayFolder: 03 NII Bridge
		lineageTag: 5938abb1-db82-4392-92c4-93a196a45b54

	/// Residual (new products, rounding).
	measure 'Bridge Other' = [NII] - [NII PY] - [Bridge Volume Effect] - [Bridge Margin Effect]
		formatString: £#,0
		displayFolder: 03 NII Bridge
		lineageTag: 2c8c778a-83f7-4967-a424-5488b9d45173

	/// Waterfall: categories bridge_steps[Step] sorted by Order; total = current period NII.
	measure 'NII Bridge Value' =
			SWITCH (
			    SELECTEDVALUE ( bridge_steps[Order] ),
			    1, [NII PY],
			    2, [Bridge Volume Effect],
			    3, [Bridge Margin Effect],
			    4, [Bridge Other]
			)
		formatString: £#,0
		displayFolder: 03 NII Bridge
		lineageTag: c663d467-0a24-4f1c-8802-95b1656a0cc4

	measure 'Gross New Lending' = SUM ( fact_product_monthly[NewLending] )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 2af4584e-539f-4e0a-836c-cab64121cda9

	measure 'Gross New Lending PY' =
			VAR _start = EDATE ( MIN ( dim_date[Date] ), -12 )
			VAR _end = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			RETURN
			    CALCULATE ( [Gross New Lending], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[Date], _start, _end ) )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 950aaf8b-96c2-4429-8d78-b04758b5ab93

	measure 'Gross New Lending YoY %' = DIVIDE ( [Gross New Lending] - [Gross New Lending PY], [Gross New Lending PY] )
		formatString: 0.0%
		displayFolder: 04 Credit Risk
		lineageTag: 5e7d790d-3bd2-4dc2-8376-9a5d1391d661

	measure 'Stage 1 Balance' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[Stage1Balance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 4d5ee539-c4a2-457b-953d-d63811091ee7

	measure 'Stage 1 Share' = DIVIDE ( [Stage 1 Balance], [Loan Book] )
		formatString: 0.0%
		displayFolder: 04 Credit Risk
		lineageTag: d011e30a-6c0c-4f4e-a1af-a44f781ec314

	measure 'Stage 2 Balance' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[Stage2Balance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 5f11846b-9af7-48ec-97e4-74ef5c5712fa

	measure 'Stage 2 Share' = DIVIDE ( [Stage 2 Balance], [Loan Book] )
		formatString: 0.0%
		displayFolder: 04 Credit Risk
		lineageTag: a680c301-f03d-4354-ba8c-13e0aebbff40

	measure 'Stage 3 Balance' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[Stage3Balance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 1a8e2ef4-0d21-4e07-88af-e04196a2fa48

	measure 'Stage 3 Share' = DIVIDE ( [Stage 3 Balance], [Loan Book] )
		formatString: 0.0%
		displayFolder: 04 Credit Risk
		lineageTag: b722d46d-9e1e-48b0-9207-360bbae9d623

	measure 'Stage 2 Share PY' =
			VAR _d = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( [Stage 2 Share], REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: 0.0%
		displayFolder: 04 Credit Risk
		lineageTag: fcbf068b-458f-45f5-b992-3434d9bc9dfe

	measure 'Stage 2 Share Change pp' = ( [Stage 2 Share] - [Stage 2 Share PY] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 04 Credit Risk
		lineageTag: aeb17b57-3606-49bc-bb1d-bba80f4f9f66

	measure 'Arrears 90+ Balance' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[Arrears90Balance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: f67df14c-feb7-42c3-ba9c-c0de12d9df03

	measure 'Arrears 90+ Rate' = DIVIDE ( [Arrears 90+ Balance], [Loan Book] )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: 1276fb2f-70f1-4397-bb7c-579446e16801

	measure 'Arrears 90+ Rate PY' =
			VAR _d = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( [Arrears 90+ Rate], REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: 422ed40a-357c-48f7-a2e6-6c2f67b27802

	measure 'Arrears 90+ Change bps' = ( [Arrears 90+ Rate] - [Arrears 90+ Rate PY] ) * 10000
		formatString: +0;-0;0
		displayFolder: 04 Credit Risk
		lineageTag: 0552e2cd-4126-4d74-90c5-f081c579a303

	measure 'Arrears 30+ Balance' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[Arrears30Balance] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: bf7a4d46-e85c-4ffd-9fef-5e6c86526de6

	measure 'Arrears 30+ Rate' = DIVIDE ( [Arrears 30+ Balance], [Loan Book] )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: af0b8427-29b8-4a47-ba53-29e04dfbb2f4

	measure 'ECL Coverage' = DIVIDE ( [ECL Stock], [Loan Book] )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: 11eb5dd3-6c93-4a49-a88b-7fcc9486ab84

	measure 'ECL Coverage PY' =
			VAR _d = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( [ECL Coverage], REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: 07cb6ce2-107c-453e-abde-e38aac6aa33d

	measure 'ECL Coverage Change bps' = ( [ECL Coverage] - [ECL Coverage PY] ) * 10000
		formatString: +0;-0;0
		displayFolder: 04 Credit Risk
		lineageTag: 4628131a-6b09-4ce8-ac94-7a6fb468d9fe

	/// ECL at the end of the month before the period starts.
	measure 'ECL Opening' =
			VAR _d = EOMONTH ( MIN ( dim_date[Date] ), -1 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_product_monthly[ECL] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: da3918e8-60b6-4136-9d9d-ec33769f22c3

	/// Write-offs net of the government guarantee (Bounce Back Loans).
	measure 'Net Write-offs' = SUM ( fact_product_monthly[WriteOff] ) - SUM ( fact_product_monthly[GuaranteeClaim] )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 75fb3965-f5e7-4351-af5b-dec6dffc0138

	/// P&L charge: change in ECL allowance plus net write-offs.
	measure 'Impairment Charge' = [ECL Stock] - [ECL Opening] + [Net Write-offs]
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 0967a21d-f66b-4c68-982c-35f06c772bf0

	measure 'Impairment Budget' =
			VAR _l = [Last Actual Date]
			RETURN
			    CALCULATE ( SUM ( fact_budget_monthly[BudgetImpairment] ), KEEPFILTERS ( dim_date[Date] <= _l ) )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: ef9e60de-bd1f-454e-ad87-9ba443a68bb0

	/// Annualised impairment charge over average loans.
	measure 'Cost of Risk' = DIVIDE ( [Impairment Charge] * 12 / [Months In Period], [Avg Loan Balance] )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: 66d29c55-d7fd-4fd3-a710-31c4996b3ca2

	measure 'Cost of Risk PY' =
			VAR _start = EDATE ( MIN ( dim_date[Date] ), -12 )
			VAR _end = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			RETURN
			    CALCULATE ( [Cost of Risk], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[Date], _start, _end ) )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: 27868c88-598f-4d6b-9d40-a112a396df19

	measure 'Cost of Risk Change bps' = ( [Cost of Risk] - [Cost of Risk PY] ) * 10000
		formatString: +0;-0;0
		displayFolder: 04 Credit Risk
		lineageTag: df5c45e4-7a90-4ec0-b701-224786e0fdd4

	/// Use by month (COVID payment deferrals, 2020).
