	measure 'Repricing Old Rate' = DIVIDE ( SUM ( fact_mortgage_repricing[OldRateXBalance] ), SUM ( fact_mortgage_repricing[Balance] ) ) / 100
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: 7bda7a5f-8d68-4dad-b178-27eb5a886c78

	measure 'Repricing New Rate' = DIVIDE ( SUM ( fact_mortgage_repricing[NewRateXBalance] ), SUM ( fact_mortgage_repricing[Balance] ) ) / 100
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: a1a6399c-14f2-4055-88d9-c9c35a06773f

	/// Average change in the monthly mortgage payment when a fixed deal reprices.
	measure 'Payment Shock %' = DIVIDE ( SUM ( fact_mortgage_repricing[NewPayment] ), SUM ( fact_mortgage_repricing[OldPayment] ) ) - 1
		formatString: 0.0%
		displayFolder: 04 Credit Risk
		lineageTag: 7505e89d-d74a-4278-91fd-fe7b027e2b84

	/// Bounce Back Loans: share of loans ever 90+ or written off by months on book.
	measure 'BBL Cumulative Default Rate' = DIVIDE ( SUM ( fact_bbl_vintage[DefaultedLoans] ), SUM ( fact_bbl_vintage[Loans] ) )
		formatString: 0.0%
