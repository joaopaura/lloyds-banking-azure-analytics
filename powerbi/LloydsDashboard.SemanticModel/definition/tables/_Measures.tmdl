	/// FCA DISP 8-week rule; open complaints excluded.
	measure 'Resolved Within 8 Weeks %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_complaint ), fact_complaint[IsResolvedWithin8Weeks] = TRUE () ),
			    CALCULATE ( COUNTROWS ( fact_complaint ), NOT ISBLANK ( fact_complaint[IsResolvedWithin8Weeks] ) )
			)
		formatString: 0.0%
		displayFolder: 06 Conduct
		lineageTag: 5b3b8c72-707f-4ec3-a73e-657b0e14298a

	measure 'Upheld %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_complaint ), fact_complaint[IsUpheld] = TRUE () ), [Complaints] )
		formatString: 0.0%
		displayFolder: 06 Conduct
		lineageTag: 585e57da-112a-43c0-b0f9-e8f485fae2e9

	measure 'Redress Paid' = SUM ( fact_complaint[RedressAmount] )
		formatString: £#,0
		displayFolder: 06 Conduct
		lineageTag: badae0c6-34f8-4802-a663-b80135e6e04a

	measure 'FOS Referral %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_complaint ), fact_complaint[IsReferredToFOS] = TRUE () ), [Complaints] )
		formatString: 0.0%
		displayFolder: 06 Conduct
		lineageTag: b44d7b51-71ec-4a4f-a1c8-b530b9197db4

	measure 'Open Complaints' = CALCULATE ( COUNTROWS ( fact_complaint ), fact_complaint[IsOpen] = TRUE () )
		formatString: #,0
		displayFolder: 06 Conduct
		lineageTag: 9e036856-aa7a-48d4-a1c4-adfcdde8fde8

	measure 'Fraud Cases' = COUNTROWS ( fact_fraud_case )
		formatString: #,0
		displayFolder: 06 Conduct
		lineageTag: 7ec4f05e-9530-4ae0-bd2d-7ed5e2e8d88e

	measure 'Fraud Losses' = SUM ( fact_fraud_case[LossAmount] )
		formatString: £#,0
		displayFolder: 06 Conduct
		lineageTag: f753b0cc-5bc7-4b13-9b9f-de1547cb4a60

	measure 'APP Scam Losses' = CALCULATE ( [Fraud Losses], fact_fraud_case[FraudType] = "APP Scam" )
		formatString: £#,0
		displayFolder: 06 Conduct
		lineageTag: 99bff8a3-e19f-4162-bf64-2a12eb23da67

	measure 'APP Scam Reimbursed' = CALCULATE ( SUM ( fact_fraud_case[ReimbursedAmount] ), fact_fraud_case[FraudType] = "APP Scam" )
		formatString: £#,0
		displayFolder: 06 Conduct
		lineageTag: af7f6cb2-6c2d-4e8f-a166-30a158b18154

	/// Mandatory reimbursement from 7 Oct 2024 (PSR rule).
	measure 'APP Reimbursement Rate' = DIVIDE ( [APP Scam Reimbursed], [APP Scam Losses] )
		formatString: 0.0%
		displayFolder: 06 Conduct
		lineageTag: 0c211141-eb23-4616-a89d-8122345202fd

	measure 'APP Reimbursement Rate PY' =
			VAR _start = EDATE ( MIN ( dim_date[Date] ), -12 )
			VAR _end = EOMONTH ( EDATE ( [Period End Date], -12 ), 0 )
			RETURN
			    CALCULATE ( [APP Reimbursement Rate], REMOVEFILTERS ( dim_date ), DATESBETWEEN ( dim_date[Date], _start, _end ) )
		formatString: 0.0%
		displayFolder: 06 Conduct
		lineageTag: 814c8399-b5eb-40fa-aab9-1cfe50701d1e

	measure 'APP Reimbursement Change pp' = ( [APP Reimbursement Rate] - [APP Reimbursement Rate PY] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 06 Conduct
		lineageTag: f52ac108-51e6-42aa-bb82-83873269c0bd

	/// Cost to the bank: reimbursed minus recovered from receiving banks.
	measure 'Fraud Net Cost' = SUM ( fact_fraud_case[ReimbursedAmount] ) - SUM ( fact_fraud_case[RecoveredAmount] )
		formatString: £#,0
		displayFolder: 06 Conduct
		lineageTag: 50e06a79-5b77-4e51-b5ad-d0eec139f1fb

	measure 'Rows in Warehouse' = CALCULATE ( SUM ( platform_table_stats[row_count] ), platform_table_stats[layer] = "gold" )
		formatString: #,0
		displayFolder: 07 Platform
		lineageTag: ec170e18-1241-49e5-b61c-da36d981bcfa

	measure 'Rows All Layers' = SUM ( platform_table_stats[row_count] )
		formatString: #,0
		displayFolder: 07 Platform
		lineageTag: f6ba2cbe-0e2e-41af-948c-0d4c4381782d

	measure 'Warehouse Size MB' = SUM ( platform_table_stats[used_mb] )
		formatString: #,0
		displayFolder: 07 Platform
		lineageTag: 61a6ddb0-32d9-4ee3-a457-c4026652ec63

	measure 'Tables Monitored' = DISTINCTCOUNT ( platform_table_stats[table_name] )
		formatString: #,0
		displayFolder: 07 Platform
		lineageTag: cadbab6e-92f0-4986-8514-14c19ae25edd

	measure 'Pipeline Runs' = COUNTROWS ( pipeline_runs )
		formatString: #,0
		displayFolder: 07 Platform
		lineageTag: 92bd2ef0-6ae7-497b-bb6e-683bc297a501

	measure 'Pipeline Success Rate' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( pipeline_runs ), pipeline_runs[status] = "Succeeded" ),
			    CALCULATE ( COUNTROWS ( pipeline_runs ), pipeline_runs[status] IN { "Succeeded", "Failed" } )
			)
		formatString: 0.0%
		displayFolder: 07 Platform
		lineageTag: 8f5762df-cb6a-4920-ae65-63980bb778f3

	measure 'Rows Copied' = SUM ( pipeline_runs[rows_written] )
		formatString: #,0
		displayFolder: 07 Platform
		lineageTag: fdf52841-2566-4c15-a23c-233b208ca7f8

	/// Copy window of the latest load day (staging copies).
	measure 'Last Load Duration min' =
			VAR _day = CALCULATE ( MAX ( pipeline_runs[run_date] ), REMOVEFILTERS ( pipeline_runs ) )
			VAR _s = CALCULATE ( MIN ( pipeline_runs[started_at_utc] ), REMOVEFILTERS ( pipeline_runs ), pipeline_runs[run_date] = _day )
			VAR _e = CALCULATE ( MAX ( pipeline_runs[ended_at_utc] ), REMOVEFILTERS ( pipeline_runs ), pipeline_runs[run_date] = _day )
			RETURN
			    DATEDIFF ( _s, _e, MINUTE )
		formatString: #,0
		displayFolder: 07 Platform
		lineageTag: b33b59d6-e6b1-4e5a-aae0-a047e5e9790d

	measure 'DQ Issues Fixed' = SUM ( data_quality_summary[affected_rows] )
		formatString: #,0
		displayFolder: 07 Platform
		lineageTag: 58df6320-5d85-4e4b-a02f-ab3ceff78598

