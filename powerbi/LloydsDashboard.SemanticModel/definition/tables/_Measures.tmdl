		displayFolder: 04 Credit Risk
		lineageTag: 600e6c67-4196-483e-8b68-ba428da7a4e5

	measure 'Risk EAD' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_credit_risk_monthly[EAD] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 464edb09-707e-4d5e-bb96-f5d8bb47322e

	measure 'Risk PD x EAD' =
			VAR _d = EOMONTH ( [Period End Date], 0 )
			VAR _k = YEAR ( _d ) * 10000 + MONTH ( _d ) * 100 + DAY ( _d )
			RETURN
			    CALCULATE ( SUM ( fact_credit_risk_monthly[PDxEAD] ), REMOVEFILTERS ( dim_date ), dim_date[DateKey] = _k )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: cf584453-6df1-48ba-993b-0a8a3cce00a8

	/// EAD-weighted 12-month PD.
	measure 'Risk Avg PD' = DIVIDE ( [Risk PD x EAD], [Risk EAD] )
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: 548c10d5-b7c1-48d0-8fc3-60446a192f4e

	/// Remortgage wall: fixed-rate balances by deal end quarter (snapshot at last actual month).
	measure 'Maturing Fixed Balance' = SUM ( fact_mortgage_maturity[Balance] )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: da32ee70-2639-4fe0-af7e-c2586a48f5a9

	measure 'Maturing Fixed Accounts' = SUM ( fact_mortgage_maturity[Accounts] )
		formatString: #,0
		displayFolder: 04 Credit Risk
		lineageTag: dfeff92b-31e0-43b8-92d3-22318690a2cd

	measure 'Maturing Avg Current Rate' = DIVIDE ( SUM ( fact_mortgage_maturity[RateXBalance] ), SUM ( fact_mortgage_maturity[Balance] ) ) / 100
		formatString: 0.00%
		displayFolder: 04 Credit Risk
		lineageTag: eb90dce1-8dfa-46a1-ae35-0a3d9e15c00a

	measure 'Maturing Next 12M Balance' =
			VAR _l = [Last Actual Date]
			VAR _lk = YEAR ( _l ) * 10000 + MONTH ( _l ) * 100 + DAY ( _l )
			VAR _e = EOMONTH ( _l, 12 )
			VAR _ek = YEAR ( _e ) * 10000 + MONTH ( _e ) * 100 + DAY ( _e )
			RETURN
			    CALCULATE ( SUM ( fact_mortgage_maturity[Balance] ), fact_mortgage_maturity[DealEndMonthKey] > _lk, fact_mortgage_maturity[DealEndMonthKey] <= _ek )
		formatString: £#,0
		displayFolder: 04 Credit Risk
		lineageTag: 1c215a2c-2bf6-4ca6-9530-3772ceb85e14

	measure Repricings = SUM ( fact_mortgage_repricing[Repricings] )
