{
  "name": "Lloyds Portfolio | Green",
  "dataColors": [
    "#006A4D",
    "#11B67A",
    "#C97A00",
    "#8C5BB5",
    "#D1495B",
    "#7C8F86",
    "#B8C4BE"
  ],
  "background": "#FFFFFF",
  "foreground": "#1D1D1B",
  "tableAccent": "#006A4D",
  "good": "#188038",
  "neutral": "#E8A317",
  "bad": "#C5221F",
  "maximum": "#00402E",
  "center": "#6FB597",
  "minimum": "#EAF4EF",
  "null": "#F3F6F4",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1B"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1D1D1B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#51625A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1D1D1B"
              }
            },
            "alignment": "left"
          }
        ],
        "padding": [
          {
            "top": 12,
            "bottom": 8,
            "left": 16,
            "right": 16
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#51625A"
              }
            },
            "fontSize": 9,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#51625A"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E3EAE6"
              }
            },
            "gridlineStyle": "dotted",
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#51625A"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#51625A"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F6F4"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#51625A"
              }
            },
            "textSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1D1D1B"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E3EAE6"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#006A4D"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#006A4D"
              }
            }
          }
        ]
      }
    }
  }
}